# Local dev uses the Postgres started by `scripts/dev-db.sh`.
# In production set this to the Supabase connection string.
DATABASE_URL=postgresql://jobrail:jobrail@localhost:5432/jobrail

# Optional. Free tier at https://developer.adzuna.com — unlocks 16 countries.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Shared secret required by POST /api/ingest, so only the scheduled
# workflow can trigger a crawl.
INGEST_SECRET=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
