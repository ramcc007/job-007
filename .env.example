# Nothing here is required to run the site — every keyed source disables
# itself cleanly when unconfigured, and the keyless ones still work.
# Each key below widens coverage; the notes say by how much.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Aggregators -----------------------------------------------------------
# The lawful route to listings that Indeed, LinkedIn, Naukri, iimjobs and
# Monster/Foundit do not expose directly. Each licenses the inventory it
# indexes; none requires scraping a site that forbids it.

# Adzuna — 19 national markets including India. The single biggest win.
# Free: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — indexes Indeed, LinkedIn, Glassdoor, ZipRecruiter
# and Google for Jobs, keeping each listing's original publisher.
# Free tier: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Jooble — 60+ countries, indexes national boards and names the source of
# each listing. Free key on request: https://jooble.org/api/about
JOOBLE_KEY=

# Careerjet — around 90 countries, India included.
# Free affiliate id: https://www.careerjet.com/partners/affiliate.html
CAREERJET_AFFID=
